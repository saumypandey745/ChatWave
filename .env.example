# ChatWave Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String (If left empty or unavailable, MongoMemoryServer is launched automatically in dev)
MONGO_URI=mongodb://localhost:27017/chatwave

# JWT Secrets
JWT_SECRET=chatwave_jwt_super_secret_key_2026_change_in_production
JWT_REFRESH_SECRET=chatwave_jwt_refresh_super_secret_key_2026_change_in_production

# Frontend Origin for CORS & Refresh Cookies
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cloudinary Configuration (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration for Password Reset
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_smtp_user
SMTP_PASS=dummy_smtp_password
SMTP_FROM="ChatWave Support <no-reply@chatwave.com>"
